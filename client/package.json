{
  "name": "fyro-client",
  "version": "1.0.0",
  "scripts": {
    "predev": "node -e \"require('fs').rmSync('.next-dev',{ recursive: true, force: true })\"",
    "dev": "set NEXT_DIST_DIR=.next-dev&& next dev",
    "prebuild": "node -e \"require('fs').rmSync('.next',{ recursive: true, force: true })\"",
    "build": "set NEXT_DIST_DIR=.next&& next build",
    "start": "set NEXT_DIST_DIR=.next&& next start"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "framer-motion": "^11.0.8",
    "axios": "^1.6.8",
    "socket.io-client": "^4.7.4",
    "leaflet": "^1.9.4",
    "recharts": "^2.12.4",
    "react-hot-toast": "^2.4.1",
    "jose": "^5.2.4",
    "lucide-react": "^0.363.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/leaflet": "^1.9.8",
    "typescript": "^5",
    "tailwindcss": "^3.4.1",
    "postcss": "^8",
    "autoprefixer": "^10.0.1"
  }
}
